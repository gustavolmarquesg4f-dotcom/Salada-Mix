[Unit]
Description=Salada Mix Laravel Queue Worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/salada-mix/current
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --timeout=90
Restart=always
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

